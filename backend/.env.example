# Flask Secret Keys
SECRET_KEY=YOUR_SUPER_SECRET_FLASK_KEY_REPLACE_IN_PRODUCTION
JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET_KEY_SHA256_REPLACE_IN_PRODUCTION
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# MongoDB Atlas Database Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://amarganesh11:amarganesh11@cluster0.wmuzdt1.mongodb.net/shree_amar_ganesh_db?retryWrites=true&w=majority&appName=Cluster0
DB_NAME=shree_amar_ganesh_db

# Storage & Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Mandal Defaults
